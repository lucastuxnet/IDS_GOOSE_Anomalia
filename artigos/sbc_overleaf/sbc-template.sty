% sbc-template.sty -- versao COMPATIVEL para compilacao local.
% Reproduz o leiaute do modelo SBC (A4, Times 12pt, titulo Helvetica 16pt,
% resumo/abstract em italico recuado, secoes 13pt).
% >>> No Overleaf, prefira o sbc-template.sty OFICIAL do modelo
% "SBC Conferences Template": basta substituir este arquivo; nenhum
% comando do main.tex precisa mudar. <<<
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2026/11/15 SBC compativel]
\RequirePackage{mathptmx}
\RequirePackage[scaled=.92]{helvet}
\RequirePackage{courier}
\RequirePackage[a4paper,top=3.5cm,bottom=2.5cm,left=3cm,right=3cm]{geometry}
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf,labelsep=period}
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{6pt}
\pagestyle{empty}
\sloppy
% ---- autores / instituicoes
\def\inst#1{\unskip$^{#1}$}
\def\@address{}
\newcommand{\address}[1]{\gdef\@address{#1}}
\newcounter{instn}
\def\nextinstitute{\par\vskip 6pt\stepcounter{instn}$^{\theinstn}$}
\newcommand{\email}[1]{\par\vskip 6pt{\small\texttt{#1}}}
\renewcommand{\maketitle}{%
  \newpage\null
  \begin{center}%
    {\fontsize{16}{20}\usefont{OT1}{phv}{b}{n}\selectfont \@title\par}%
    \vskip 12pt
    {\fontsize{12}{14}\bfseries \@author\par}%
    \vskip 12pt
    {\fontsize{12}{14}\selectfont \setcounter{instn}{1}$^{\theinstn}$\@address\par}%
  \end{center}%
  \vskip 6pt
  \thispagestyle{empty}\setcounter{footnote}{0}}
% ---- abstract / resumo
\renewenvironment{abstract}%
  {\list{}{\leftmargin=0.8cm\rightmargin=0.8cm\listparindent=0pt\parsep=0pt}%
   \item\relax\itshape\textbf{Abstract.}\ }{\endlist}
\newenvironment{resumo}%
  {\list{}{\leftmargin=0.8cm\rightmargin=0.8cm\listparindent=0pt\parsep=0pt}%
   \item\relax\itshape\textbf{Resumo.}\ }{\endlist}
% ---- secoes
\renewcommand\section{\@startsection{section}{1}{\z@}{-12pt}{6pt}%
  {\fontsize{13}{15}\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-12pt}{6pt}%
  {\fontsize{12}{14}\bfseries}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}{-12pt}{6pt}%
  {\normalsize\bfseries}}
% ---- citacoes no formato [Autor Ano]
\renewcommand\refname{Refer\^encias}
\def\@biblabel#1{}
\renewenvironment{thebibliography}[1]%
  {\section*{\refname}\small
   \list{}{\leftmargin=0.5cm\itemindent=-0.5cm\itemsep=2pt\parsep=0pt}%
   \sloppy\clubpenalty4000\widowpenalty4000}{\endlist}
\endinput
